# Copy to .env.local for local dev. Set the same variable in Amplify for the live site.

# Activity API base URL (SPEC §9.2): the ExamPrepLabApi stack's `ActivityApiUrl` output,
# without a trailing /activity. Leave unset to turn Activity recording off (nothing is queued).
# VITE_ACTIVITY_API=https://xxxxxxxxxx.execute-api.us-west-1.amazonaws.com

# Admin Page (/admin, SPEC §9.3): needs VITE_ACTIVITY_API plus these two ExamPrepLabApi outputs.
# VITE_COGNITO_DOMAIN=https://exampreplab-admin.auth.us-west-1.amazoncognito.com   # HostedUiDomain
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx                               # ClientId
